# Copy to .env and fill in. deploy.py and smoke_test.py read it. Never commit .env.
# Nothing here is a secret: the agent gets its Highflame token from AgentCore Identity.

# --- AWS --------------------------------------------------------------------------------
# The AWS profile to deploy with. Unset = boto's default credential chain.
# AWS_PROFILE=
AWS_REGION=us-east-1
# Optional. The S3 bucket for the agent's code. Default: highflame-agentcore-code-<account>-<region>.
# CODE_BUCKET=
# Optional. The Bedrock model the agent uses.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Highflame --------------------------------------------------------------------------
# Your Highflame issuer URL: the `issuer` in /.well-known/oauth-authorization-server.
HIGHFLAME_ISSUER_URL=https://auth.highflame.ai
# The LLM Base URL on Studio -> AI Gateway -> LLM Providers, followed by /v1.
HIGHFLAME_LLM_URL=https://gateway.highflame.ai/llm/v1
# Optional. The AgentCore Identity credential provider's name. Default: highflame-agents.
# HIGHFLAME_PROVIDER=highflame-agents
# Optional. The scopes the agent asks for, space-separated. Unset, it asks for none and gets
# what its credential policy allows. Each one must be allowed by that policy.
# HIGHFLAME_SCOPES=

# --- invoking the agent ---------------------------------------------------------------
# Optional. The runtime user that deploy.py invoke and smoke_test.py send with SigV4.
# AgentCore hands the agent a workload access token only when the caller names one.
# RUNTIME_USER_ID=recipe-operator
# The runtime the live smoke test invokes (deploy.py deploy NAME). Unset, it skips.
# SMOKE_RUNTIME=acme_crm_agent
