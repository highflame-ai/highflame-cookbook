# A Highflame service key from Studio -> Settings -> API Keys (or the agent-gateway key
# shown on the adopted agent in the registry).
HIGHFLAME_API_KEY=

# Optional: the adopted agent this request is attributed to (defaults to
# reporting-agent@example.com). With Highflame's identity gate enabled, set this to a
# real identity in your Highflame org — the one your connector discovered and you
# adopted — or the request is denied as unknown. See README.md#notes.
# HIGHFLAME_AGENT_IDENTITY=reporting-agent@yourco.com

# Optional: override the agent-request endpoint (defaults to prod).
# HIGHFLAME_AGENT_ENDPOINT=https://api.highflame.ai/v1/cerberus/agent/events
