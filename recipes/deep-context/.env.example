# Deep-context recipe configuration.
#
# Everything in this recipe hangs off ONE idea: a stable session_id per
# conversation. The vars below just say which deployment to send it to.

# --- Credential --------------------------------------------------------------
# The key of an agent you register in Studio:
#   Registry -> Agents -> Inventory -> Register Identity.   Shown once, on creation.
#
# Register it with external ID `assistant`, sub type `human_proxy`, trust level
# `first_party`, and the default credential policy. The SDK exchanges the key for a
# short-lived token automatically.
#
# Trust level is the field that changes what the recipe shows. Anything that is not a
# registered agent arrives as `unverified`, and the dual-attribution policy in
# policies/ refuses every sensitive tool call from an unverified agent -- including the
# clean-session control the walkthrough uses to show that ordinary use still works.
HIGHFLAME_API_KEY=zid_sk_your_key_here

# --- Shield (the guard endpoint) ---------------------------------------------
# SaaS:        https://api.highflame.ai
# Self-hosted: http://localhost:8070
HIGHFLAME_BASE_URL=https://api.highflame.ai

# --- AuthN (key → token exchange) --------------------------------------------
# Not derived from HIGHFLAME_BASE_URL. If you point the base URL at a
# self-hosted deployment, set this too — otherwise the key exchange goes to
# SaaS and fails with a 401 that does not name the cause.
# SaaS: https://auth.highflame.ai/oauth2/token
HIGHFLAME_TOKEN_URL=https://auth.highflame.ai/oauth2/token

# --- Observatory (the session timeline, section 7) ---------------------------
# Optional. Without it the walkthrough still runs; it just links you to Studio
# instead of printing the timeline inline.
# SaaS: https://api.highflame.ai
HIGHFLAME_OBSERVATORY_URL=

# --- Studio (for the "open this session" link) -------------------------------
HIGHFLAME_STUDIO_URL=https://studio.highflame.ai

# --- Cosmetic ----------------------------------------------------------------
# Labels used in the walkthrough's narrative only. They do NOT set the agent
# identity — Shield resolves that from the credential and ignores anything the
# caller asserts about itself.
HIGHFLAME_AGENT_LABEL=research-agent
HIGHFLAME_OPERATOR=you@example.com
