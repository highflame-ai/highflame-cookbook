# Deep-context recipe configuration.
#
# Everything in this recipe hangs off ONE idea: a stable session_id per
# conversation. The vars below just say which deployment to send it to.

# --- Credential --------------------------------------------------------------
# A service key from Studio → Settings → API Keys. Both the current zid_sk_
# format and the legacy hf_sk_ format work; the SDK exchanges either for a
# short-lived RS256 JWT automatically.
HIGHFLAME_API_KEY=zid_sk_your_key_here

# --- Shield (the guard endpoint) ---------------------------------------------
# SaaS:        https://api.highflame.ai
# dev1:        https://api-dev.highflame.dev
# Self-hosted: http://localhost:8070
HIGHFLAME_BASE_URL=https://api.highflame.ai

# --- AuthN (key → JWT exchange) ----------------------------------------------
# The SDK does NOT derive this from HIGHFLAME_BASE_URL. If you point the base
# URL at a non-SaaS environment you must override this too, or the exchange
# silently goes to prod and fails with a confusing 401.
# SaaS: https://auth.highflame.ai/oauth2/token
# dev1: https://auth-dev.highflame.dev/oauth2/token
HIGHFLAME_TOKEN_URL=https://auth.highflame.ai/oauth2/token

# --- Observatory (the session timeline, section 7) ---------------------------
# Optional. Without it the walkthrough still runs; it just links you to Studio
# instead of printing the timeline inline.
# SaaS: https://api.highflame.ai
# dev1: https://api-dev.highflame.dev
HIGHFLAME_OBSERVATORY_URL=

# --- Studio (for the "open this session" link) -------------------------------
# SaaS: https://studio.highflame.ai
# dev1: https://studio-dev.highflame.dev
HIGHFLAME_STUDIO_URL=https://studio.highflame.ai

# --- Cosmetic ----------------------------------------------------------------
# Labels used in the walkthrough's narrative only. They do NOT set the agent
# identity — Shield resolves that from the credential and ignores anything the
# caller asserts about itself.
HIGHFLAME_AGENT_LABEL=research-agent
HIGHFLAME_OPERATOR=you@example.com

# --- Optional: creating the policies -----------------------------------------
# create_policies.py posts to Admin, which does NOT accept the service key
# above. It needs a Studio session token (Clerk). See create_policies.py's
# docstring for how to get one.
# HIGHFLAME_ADMIN_URL=https://control-dev.highflame.dev
# HIGHFLAME_ADMIN_TOKEN=

# --- Optional: real model traffic through the AI Gateway ---------------------
# Only needed for `python guarded_agent.py --live`.
# HIGHFLAME_GATEWAY_URL=https://gateway.highflame.ai/llm/v1
# OPENAI_API_KEY=sk-...
