# Required. Your Highflame API key, from
# Studio -> AI Gateway -> Settings -> API Keys -> Create API Key.
# It identifies you to the gateway; it is NOT your model provider key.
HIGHFLAME_API_KEY=

# Required. The LLM Base URL from Studio -> AI Gateway -> LLM Providers.
HIGHFLAME_GATEWAY_BASE_URL=https://gateway.highflame.ai/llm/v1

# Required for the default setup. The gateway is bring-your-own-key for OpenAI-compatible
# providers, so it forwards this upstream and injects nothing of its own. If an administrator
# has put your provider in a brokered credential mode, the gateway supplies the credential
# and you can leave this unset. OPENAI_API_KEY is used as a fallback if you already have it.
PROVIDER_API_KEY=

# Optional. Must be provider/model. Defaults to openai/gpt-4o-mini.
# MODEL_ID=openai/gpt-4o-mini

# Optional, and set together. Only for an on-prem or air-gapped deployment; unset means the
# hosted product. On an air-gapped install both are http://<host>, and HIGHFLAME_GATEWAY_BASE_URL
# above is http://<host>/gateway/llm/v1. Plain http:// is accepted only for a private address.
# HIGHFLAME_API_URL=https://api.highflame.ai
# HIGHFLAME_AUTH_URL=https://auth.highflame.ai

# --- The two Strands + Notion notebooks (PROVIDER_API_KEY and MODEL_ID are not used there) ---

# Optional. The region of the AWS Bedrock provider under Studio -> AI Gateway -> LLM Providers.
# AWS_REGION=us-east-1

# Optional. The AWS profile to mint a short-term Bedrock API key from. Unset = boto's default chain.
# AWS_PROFILE=

# Optional. A Bedrock API key to use instead of minting one.
# BEDROCK_API_KEY=

# Optional. Defaults to us.anthropic.claude-sonnet-4-5-20250929-v1:0.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# strands_bedrock_mcp_via_mcp_gateway.ipynb only. Optional: the Notion server's MCP gateway URL.
# HIGHFLAME_MCP_URL=https://gateway.highflame.ai/mcp/notion

# strands_bedrock_mcp_via_ai_gateway.ipynb only. Optional: Notion's own MCP URL.
# MCP_SERVER_URL=https://mcp.notion.com/mcp
# OAUTH_CALLBACK_PORT=8765
