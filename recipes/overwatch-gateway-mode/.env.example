# Copy to .env and fill in. Never commit the real file.

# --- Highflame (prod / SaaS defaults) ---
HIGHFLAME_GATEWAY_KEY=zid_sk_replace_me                  # gateway key: Studio -> Settings -> API Keys
HIGHFLAME_GATEWAY_URL=https://gateway.highflame.ai/llm   # store the form ending at /llm

# Each agent derives the exact URL its own client needs from the value above, so
# do not add a version segment here. Overwatch gives Codex `/llm/v1` because its
# client appends only `/responses`, while Claude Code appends `/v1/messages`.
