# A Highflame API key from Studio -> Settings -> API Keys.
# The key is scoped to one account and one project — every report you pull is
# scoped the same way. To report across several projects, use one key per
# project and merge the results.
HIGHFLAME_API_KEY=

# Optional: override the endpoints (both default to prod).
# HIGHFLAME_AUTH_URL=https://auth.highflame.ai
# HIGHFLAME_API_URL=https://api.highflame.ai
