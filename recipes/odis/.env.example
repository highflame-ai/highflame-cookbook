# ODIS recipe configuration.
#
# Two planes are involved:
#   - the identity plane (ZeroID, embedded in AuthN) issues credentials
#   - the checkpoint (Shield) enforces on them
# They must agree: Shield only trusts credentials from the issuer its JWKS is
# pinned to, so HIGHFLAME_AUTHN_URL has to be that same issuer.

# --- Identity plane (ODIS Layers 1 & 2) --------------------------------------
# SaaS:        https://api.highflame.ai
# Self-hosted: http://localhost:8051
HIGHFLAME_AUTHN_URL=http://localhost:8051

# --- Governance checkpoint (ODIS Layer 3) -----------------------------------
# SaaS:        https://api.highflame.ai
# Self-hosted: http://localhost:8070
HIGHFLAME_BASE_URL=http://localhost:8070

# --- Tenant -----------------------------------------------------------------
# Every identity, credential, and decision is scoped to both.
HIGHFLAME_ACCOUNT_ID=acc_your_account
HIGHFLAME_PROJECT_ID=proj_your_project

# The human accountable for the agents this recipe registers. ODIS-CC-05
# requires an accountable owner; the platform rejects registration without one.
HIGHFLAME_OWNER_USER_ID=your_user_id

# --- Provisioning credential — pick ONE -------------------------------------
#
# (A) PRODUCTION: a Bearer token for a "registrar" identity carrying the
#     nhi:manage scope. Provision one in Studio, then have your pipeline
#     exchange its key for a token. Nothing shared leaves the platform, and the
#     tenant is derived from the token's own claims.
HIGHFLAME_REGISTRAR_TOKEN=

# (B) SELF-HOSTED / LOCAL ONLY: the internal service secret. Convenient for a
#     local walkthrough. Do not give this to an application — it is a
#     first-party server-to-server credential, and it is not tenant-scoped by
#     itself.
HIGHFLAME_INTERNAL_SERVICE_SECRET=
HIGHFLAME_INTERNAL_SERVICE_NAME=highflame-admin
