# Highflame API key — Studio -> Settings -> API Keys.
# Sent as the X-Highflame-APIKey header; identifies your project and policies.
HIGHFLAME_API_KEY=

# Your upstream provider credential. The gateway passes it through to the provider.
OPENAI_API_KEY=

# Environment. Unset = SaaS gateway (gateway.highflame.ai).
# For dev, point at the dev gateway — and use a dev-issued API key.
# HIGHFLAME_GATEWAY_URL=https://gateway-dev.highflame.dev

# Optional: any provider/model the gateway routes, e.g. anthropic/claude-sonnet-4-5
# DEMO_MODEL=openai/gpt-5.4-mini
