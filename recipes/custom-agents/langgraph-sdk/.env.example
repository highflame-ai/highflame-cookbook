# Highflame service key — Studio -> Settings -> API Keys.
# NOTE: a key issued in dev only works against dev, and vice versa.
HIGHFLAME_API_KEY=

# Your model-provider key. In the SDK path the model call stays in your app;
# Highflame guards the steps around it.
OPENAI_API_KEY=

# --- Environment -------------------------------------------------------------
# Leave BOTH unset to run against the SaaS (api.highflame.ai / auth.highflame.ai).
#
# To test against dev, set BOTH. The token URL matters as much as the base URL:
# a dev service key will not exchange against the SaaS auth host — you get
# "[400] Bad Request: invalid api key" from the token exchange, before any guard
# call is made.
#
# HIGHFLAME_BASE_URL=https://api-dev.highflame.dev
# HIGHFLAME_TOKEN_URL=https://auth-dev.highflame.dev/oauth2/token

# --- Options -----------------------------------------------------------------
# Run only the detectors the active policies actually reference. Worth enabling
# if your policies are, say, structural-PII-only and you don't want the ML PII
# model executing on every guard call.
# HIGHFLAME_OPTIMIZE=true

# Optional: override the demo model.
# DEMO_MODEL=gpt-5.4-mini
