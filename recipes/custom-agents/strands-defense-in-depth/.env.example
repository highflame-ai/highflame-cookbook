# Highflame service key — Studio -> Settings -> API Keys.
# NOTE: a key issued in dev only works against dev, and vice versa.
HIGHFLAME_API_KEY=

# Upstream provider credential. The gateway passes it through to the provider.
OPENAI_API_KEY=

# --- Environment -------------------------------------------------------------
# Leave all three unset to run against the SaaS.
#
# For dev, set all three. The token URL matters as much as the base URL: a dev
# service key will not exchange against the SaaS auth host — you get
# "[400] Bad Request: invalid api key" before any guard call is made.
#
# HIGHFLAME_GATEWAY_URL=https://gateway-dev.highflame.dev
# HIGHFLAME_BASE_URL=https://api-dev.highflame.dev
# HIGHFLAME_TOKEN_URL=https://auth-dev.highflame.dev/oauth2/token

# --- Options -----------------------------------------------------------------
# Run only the detectors the active policies actually reference.
# HIGHFLAME_OPTIMIZE=true

# Optional: any provider/model the gateway routes.
# DEMO_MODEL=openai/gpt-5.4-mini
