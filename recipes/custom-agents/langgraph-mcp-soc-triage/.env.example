# --- Required ---------------------------------------------------------------

# Bootstrap service key for this recipe's tenant. Studio -> Settings -> API Keys.
# identities.py uses it to register the four agent identities and to mint their
# per-agent tokens (api_key grant for the workers, RFC 8693 for the responder).
HIGHFLAME_API_KEY=

# Model-provider key. The model call stays in your app — that's the SDK path.
OPENAI_API_KEY=

# --- Environment ------------------------------------------------------------

# Defaults target the SaaS. For dev, set ALL THREE — a dev service key will not
# exchange against the SaaS auth host, and the failure ([400] invalid api key)
# happens at token exchange, which reads like a bad key rather than a wrong env.
#HIGHFLAME_BASE_URL=https://api-dev.highflame.dev
#HIGHFLAME_TOKEN_URL=https://auth-dev.highflame.dev/oauth2/token
#HIGHFLAME_AUTHN_URL=https://auth-dev.highflame.dev

# --- Optional ---------------------------------------------------------------

# The analyst's own access token (PKCE login). When set, the supervisor's token
# exchange uses it as subject_token, so act.sub carries the human analyst.
# When unset, the demo falls back to the service-key identity and says so.
#HIGHFLAME_ANALYST_TOKEN=

# Model + pacing knobs (same semantics as the other custom-agents recipes).
#DEMO_MODEL=gpt-5.4-mini
#DEMO_PACE=0.35

# Step-up poll ceiling in seconds. The CIBA request itself expires server-side
# (expires_in, fail-closed deny); this only caps how long the demo waits.
#STEP_UP_WAIT_SECONDS=300
