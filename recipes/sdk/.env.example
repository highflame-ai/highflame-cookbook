# Highflame API key — generate in Studio → Settings → API Keys
# Format: zid_sk_<random>
HIGHFLAME_API_KEY=zid_sk_your_key_here

# Base URL of the Shield service.
# SaaS (default): https://api.highflame.ai
# Self-hosted / local dev: http://localhost:8070
HIGHFLAME_BASE_URL=https://api.highflame.ai

# AuthN token endpoint (exchanges the API key for an access token).
# Not derived from HIGHFLAME_BASE_URL. If you point the base URL at another
# deployment, set this to that deployment's AuthN too, or the key exchange
# goes to SaaS and fails.
# SaaS (default): https://auth.highflame.ai/oauth2/token
# Self-hosted / local dev: http://localhost:8051/oauth2/token
HIGHFLAME_TOKEN_URL=https://auth.highflame.ai/oauth2/token

# Optional: Your LLM provider key (used in the agentic session examples)
OPENAI_API_KEY=sk-...
