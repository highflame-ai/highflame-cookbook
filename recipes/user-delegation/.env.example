# Copy to .env and fill in. Never commit .env, your keys, or the .tokens/ folder.

# --- Highflame ------------------------------------------------------------------

# Your deployment's identity endpoint. Acting for a person needs a customer-managed
# deployment with domain join: Highflame's hosted service does not offer it yet.
HIGHFLAME_IDENTITY_URL=https://auth.highflame.example.com

# The MCP server the agent calls, at your Highflame MCP gateway:
#   Studio -> AI Gateway -> Quick Start -> Connect an MCP Server -> Proxy URL,
#   with your registered server's name at the end.
# Highflame binds the person's token to this URL.
MCP_SERVER_URL=https://gateway.highflame.example.com/mcp/notion

# The agent's delegation key: the EC P-256 private key whose public half you add on the
# agent in Studio (agent -> Credentials -> Delegation key). The README shows how to make one.
AGENT_PRIVATE_KEY_PATH=./agent.key.pem

# Optional. The scopes the agent asks for, space-separated. Defaults to tools:read.
# The agent's credential policy in Highflame must allow each one. For the ID-JAG flow,
# each one must also be a scope of the Highflame app in Okta.
# SCOPE=tools:read

# --- Okta: the agent's own app ------------------------------------------------------

# Your Okta org URL. Both flows use the org authorization server.
OKTA_ORG_URL=https://acme.okta.com

# The client id of the agent's OIDC app in Okta.
OKTA_CLIENT_ID=

# How the agent's app authenticates to Okta: set ONE of the two.
# The app's client secret:
# OKTA_CLIENT_SECRET=
# Or the private key (RSA or EC) whose public key is on the app, and its key id in Okta:
# OKTA_PRIVATE_KEY_PATH=./okta-agent.key.pem
# OKTA_KEY_ID=

# Optional. A sign-in redirect URI of the agent's app, for signin.py.
# Defaults to http://localhost:8765/callback.
# OKTA_REDIRECT_URI=http://localhost:8765/callback
