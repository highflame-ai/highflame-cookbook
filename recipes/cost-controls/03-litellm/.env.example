# Required. An API key in a project that only this notebook uses: once its budget is used up,
# every prompt in it is blocked until the next UTC day or until you raise the budget.
# Use a Registry agent's key (Studio -> Registry -> Register Identity), so the chargeback names
# the proxy. Any other API key in the project also works.
HIGHFLAME_API_KEY=

# Required. Your OpenAI API key. LiteLLM calls OpenAI with it directly.
# OPENAI_API_KEY is used as a fallback if you already have it.
PROVIDER_API_KEY=

# Optional. The local port for the test proxy.
# PROXY_PORT=4001

# Optional. An OpenAI model. gpt-4o costs about a cent per call in the notebook, so a $0.05
# daily budget runs out in a handful of calls.
# MODEL=gpt-4o

# Optional. The notebook reads the budget amount from Highflame; this is used only if Highflame
# does not report it.
# DAILY_BUDGET_USD=0.05

# Optional, and set together. Only for an on-prem or air-gapped deployment.
# HIGHFLAME_API_URL=https://api.highflame.ai
# HIGHFLAME_AUTH_URL=https://auth.highflame.ai
