# Required. An API key from Studio -> AI Gateway -> Settings -> API Keys, in a project that only
# this notebook uses: once its budget is used up, every prompt in it is blocked until the next
# UTC day or until you raise the budget.
HIGHFLAME_API_KEY=

# Required. Your OpenAI API key. The gateway forwards it upstream to OpenAI.
# OPENAI_API_KEY is used as a fallback if you already have it.
PROVIDER_API_KEY=

# Optional. The LLM Base URL from Studio -> AI Gateway -> LLM Providers, with /v1 appended.
# HIGHFLAME_GATEWAY_BASE_URL=https://gateway.highflame.ai/llm/v1

# Optional. An OpenAI model. gpt-4o costs about a cent per call in the notebook, so a $0.05
# daily budget runs out in a handful of calls.
# MODEL=gpt-4o

# Optional. The notebook reads the budget amount from Highflame; this is used only if Highflame
# does not report it.
# DAILY_BUDGET_USD=0.05

# Optional, and set together. Only for an on-prem or air-gapped deployment.
# HIGHFLAME_API_URL=https://api.highflame.ai
# HIGHFLAME_AUTH_URL=https://auth.highflame.ai
